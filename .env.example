AGENT_NAME=Berend

# --- Ollama ---
OLLAMA_HOST=http://localhost:11434
# Needs tool calling: qwen2.5:14b / qwen3:14b / llama3.1:8b / mistral-small
CHAT_MODEL=qwen2.5:14b
EMBED_MODEL=nomic-embed-text
NUM_CTX=16384
OLLAMA_KEEP_ALIVE=60m           # keep the model loaded between questions
# OLLAMA_THINK=false            # for qwen3/thinking models: faster answers

# --- Index storage ---
CHROMA_DIR=./data/chroma

# --- Sources ---
LOCAL_DATA_DIRS=./docs
DOCS_SITE_URLS=https://docs.example.nl/
DOCS_MAX_PAGES=500

GITLAB_URL=https://gitlab.example.nl
GITLAB_TOKEN=glpat-xxxxxxxx            # read_api scope
GITLAB_PROJECTS=platform/runbooks,platform/openshift-gitops
GITLAB_EXTENSIONS=.md,.rst,.adoc,.txt
GITLAB_INDEX_WIKIS=true

# --- Web search: searxng | brave | google | none ---
WEB_SEARCH_PROVIDER=searxng
SEARXNG_URL=http://localhost:8888
# BRAVE_API_KEY=
# GOOGLE_API_KEY=        # legacy Custom Search JSON API, stops 2027-01-01
# GOOGLE_CSE_ID=
# FETCH_ALLOWED_DOMAINS=docs.example.nl,docs.openshift.com,kubernetes.io

# --- Slack ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
# SLACK_ALLOWED_CHANNELS=C0123456789
SLACK_THREAD_FOLLOWUPS=true     # answer follow-ups in Berend's threads without @mention

# --- Indexing speed ---
INGEST_WORKERS=8                 # parallel downloads
EMBED_WORKERS=2                  # = OLLAMA_NUM_PARALLEL on the Ollama server

# --- Argo CD monitor ---
ARGOCD_URL=https://openshift-gitops-server-openshift-gitops.apps.cluster.example.nl
ARGOCD_TOKEN=                    # token of a read-only account (role:readonly)
# ARGOCD_PROJECTS=platform,tenants
# ARGOCD_SELECTOR=env=prod
ARGOCD_POLL_SECONDS=60
ARGOCD_CONFIRM_POLLS=2           # state must hold 2 polls before alerting (no flapping)
ARGOCD_ALERT_OUT_OF_SYNC=true
ARGOCD_PROGRESSING_MINUTES=15
ARGOCD_STATE_FILE=./data/argocd_state.json
ARGOCD_STORM_THRESHOLD=5         # >= 5 apps break in one poll -> one grouped alert
# ARGOCD_IGNORE_APPS=sandbox-.*,.*-preview
# Mute one app from Git: metadata.annotations: berend.io/mute: "true" | "2026-11-01T08:00:00+01:00"
ARGOCD_FETCH_LOGS=false          # pod log tails for the AI analysis (needs `logs, get` RBAC)
ALERT_REMIND_HOURS=4             # reminder in the thread while an incident stays open (0 = off)
ALERT_AI_ANALYSIS=true           # LLM posts likely cause + next steps in the alert thread
ALERT_LANGUAGE=English

# --- Mattermost alerts channel: bot token + channel id (threads, resolve edits the alert) ---
MATTERMOST_URL=https://mattermost.example.nl
MATTERMOST_TOKEN=
MATTERMOST_CHANNEL_ID=
# ...or just an incoming webhook (no threads):
# MATTERMOST_WEBHOOK_URL=https://mattermost.example.nl/hooks/xxxxxxxx
MATTERMOST_CHAT=true             # also answer @berend mentions and DMs in Mattermost (bot token)
# MATTERMOST_CHAT_CHANNELS=      # channel ids; empty = every channel the bot is in
MATTERMOST_THREAD_FOLLOWUPS=true

# --- Agent ---
MAX_TOOL_ROUNDS=5
REINDEX_INTERVAL_HOURS=24
HEALTH_PORT=8080                 # /healthz /readyz /metrics
# Internal CA for GitLab/docs/Ollama:
# REQUESTS_CA_BUNDLE=/etc/pki/tls/certs/ca-bundle.crt
